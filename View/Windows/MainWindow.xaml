<Window x:Class="college_events_desktop.View.Windows.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:college_events_desktop"
		mc:Ignorable="d"
		Title="Главная - список мероприятий" 
		Height="768" Width="1366"
		MinHeight="768" MinWidth="1366"
		WindowState="Maximized">
	<Grid>

		<Grid.RowDefinitions>
			<!--На всякий случай тут будет доп. строка-->
			<RowDefinition Height="0*"/>
			<RowDefinition/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="250"/>
			<ColumnDefinition/>
		</Grid.ColumnDefinitions>

		<!--Боковая панель навигации-->
		<Border BorderThickness="1" BorderBrush="#FF666666" Grid.Row="1" HorizontalAlignment="Right" Width="1"/>

		<ScrollViewer Margin="10" Grid.Row="1" VerticalScrollBarVisibility="Hidden">
			<StackPanel Grid.Row="1">

                <StackPanel Orientation="Horizontal">
                    <Border Width="70" Height="70" Background="#FF003D97">
                        <Border.OpacityMask>
                            <ImageBrush ImageSource="/View/Resources/img_logoSmallSochiGU.png"/>
                        </Border.OpacityMask>
                    </Border>
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" FontSize="20"/>
                </StackPanel>

                <Button x:Name="btn_menu_events" Height="50" Style="{DynamicResource ButtonStyle_accent}" BorderBrush="{x:Null}" Click="open_events_nav_menu" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Cursor="Hand" Margin="0,10,0,0">
					<Grid>
						<!--Нет реализации обновления после изменений в списке: ellipse показывает статус новых мероприятий (если видим, то новое мероприятие на модерации). Так же изменить статус в подменю event_nav_buttons-->
						<Ellipse x:Name="ellipse_new_event_status" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Width="8" Height="8" Fill="Red"/>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
							<Border Background="White" Width="25" Height="25" Margin="0,0,10,0">
								<Border.OpacityMask>
									<ImageBrush ImageSource="/View/Resources/ico_calendar_star.png"/>
								</Border.OpacityMask>
							</Border>
							<TextBlock Text="Мероприятия" FontSize="14" VerticalAlignment="Center"/>
							<Border x:Name="border_events_caret" Margin="10,0,0,0" Background="White" Width="15" Height="15">
								<Border.OpacityMask>
									<ImageBrush ImageSource="/View/Resources/ico_caret_down.png">
										<ImageBrush.RelativeTransform>
											<TransformGroup>
												<ScaleTransform CenterY="0.5" CenterX="0.5" ScaleX="1.5" ScaleY="1.5"/>
												<SkewTransform CenterX="0.5" CenterY="0.5"/>
												<RotateTransform CenterX="0.5" CenterY="0.5"/>
												<TranslateTransform X="0"/>
											</TransformGroup>
										</ImageBrush.RelativeTransform>
									</ImageBrush>
								</Border.OpacityMask>
							</Border>
						</StackPanel>
					</Grid>
				</Button>
				
				<ContentControl x:Name="submenu_events"/>
				
				<Button x:Name="btn_otganizers" Height="50" Style="{DynamicResource ButtonStyle_accent}" BorderBrush="{x:Null}" Margin="0,10,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Cursor="Hand">
					<Grid>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
							<Border Background="White" Width="25" Height="25" Margin="0,0,10,0">
								<Border.OpacityMask>
									<ImageBrush ImageSource="/View/Resources/ico_idea.png"/>
								</Border.OpacityMask>
							</Border>
							<TextBlock Text="Организаторы" FontSize="14" VerticalAlignment="Center"/>
						</StackPanel>
					</Grid>
				</Button>

				<Button x:Name="btn_groups" Height="50" Style="{DynamicResource ButtonStyle_accent}" BorderBrush="{x:Null}" Margin="0,10,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Cursor="Hand">
					<Grid>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
							<Border Background="White" Width="25" Height="25" Margin="0,0,10,0">
								<Border.OpacityMask>
									<ImageBrush ImageSource="/View/Resources/ico_users.png"/>
								</Border.OpacityMask>
							</Border>
							<TextBlock Text="Группы" FontSize="14" VerticalAlignment="Center"/>
						</StackPanel>
					</Grid>
				</Button>

                <Button Margin="0,10,0,0" Height="50" Style="{DynamicResource ButtonStyle_accent}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Border Width="25" Height="25" Margin="0,0,10,0" Background="White">
                            <Border.OpacityMask>
                                <ImageBrush ImageSource="/View/Resources/ico_glasses.png"/>
                            </Border.OpacityMask>
                        </Border>
                        <TextBlock Text="Кураторы" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btn_users" Height="50" Style="{DynamicResource ButtonStyle_accent}" BorderBrush="{x:Null}" Margin="0,10,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="open_users_nav_menu_Click" Cursor="Hand">
					<Grid>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
							<Border Background="White" Width="25" Height="25" Margin="0,0,10,0">
								<Border.OpacityMask>
									<ImageBrush ImageSource="/View/Resources/ico_user_gear.png"/>
								</Border.OpacityMask>
							</Border>
							<TextBlock Text="Пользователи" FontSize="14" VerticalAlignment="Center"/>
							<Border x:Name="border_supervisors_caret" Margin="10,0,0,0" Background="White" Width="15" Height="15">
								<Border.OpacityMask>
									<ImageBrush ImageSource="/View/Resources/ico_caret_down.png">
										<ImageBrush.RelativeTransform>
											<TransformGroup>
												<ScaleTransform CenterY="0.5" CenterX="0.5" ScaleX="1.5" ScaleY="1.5"/>
												<SkewTransform CenterX="0.5" CenterY="0.5"/>
												<RotateTransform CenterX="0.5" CenterY="0.5"/>
												<TranslateTransform X="0"/>
											</TransformGroup>
										</ImageBrush.RelativeTransform>
									</ImageBrush>
								</Border.OpacityMask>
							</Border>
						</StackPanel>
					</Grid>
				</Button>

				<ContentControl x:Name="submenu_users"/>
            </StackPanel>
		</ScrollViewer>



		<!--Навигируемая часть страницы-->
		<Frame x:Name="mainframe" Grid.Row="1" Grid.Column="1" />
		
	</Grid>
</Window>
